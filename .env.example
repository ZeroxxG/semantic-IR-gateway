# ==============================================================================
# ContextFlow Environment Configuration
# Copy this file to .env and insert your API keys:
# cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Default Primary Engine - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Secondary / Fast Fallback Engine - Free Tier)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Host (Optional local model fallback)
# In Docker, use host.docker.internal to connect to Ollama running on your host machine
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b

# Django Settings
DJANGO_SECRET_KEY=django-insecure-contextflow-secret-key-2026
DEBUG=False
ALLOWED_HOSTS=*

# Host Port Mapping
BACKEND_PORT=8001
FRONTEND_PORT=5173

