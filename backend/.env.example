# Google Gemini API Key (Default Primary Engine - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Secondary / Fast Fallback Engine - Free Tier)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Host (Local Fallback - e.g. http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-semantic-sir-gateway-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
